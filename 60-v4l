# FIXED: Check SUBSYSTEM or ACTION variations to guarantee early boot tracking
if [ "$SUBSYSTEM" = "video4linux" ] || [ "$ACTION" = "bind" ] || [ "$ACTION" = "add" ]; then
    
    # Allow the kernel extra room to completely settle system variables
    sleep 1

    mkdir -p /dev/v4l/by-id

    # If triggered via standard USB hotplug block, extract the node directory manually
    if [ -z "$MDEV" ] && [ -d "/sys$DEVPATH/video4linux" ]; then
        videos=$(ls "/sys$DEVPATH/video4linux")
    elif [ -n "$MDEV" ]; then
        videos="$MDEV"
    else
        # Direct fallback check for stock items if vars are stripped
        videos=$(ls /sys/class/video4linux 2>/dev/null)
    fi

    for node in $videos
    do
        # Ensure we are handling the clean base name (e.g., video0 instead of a full path)
        node=${node##*/}

        # Protect against non-video subnodes (like metadata nodes) crashing v4l2-ctl
        if echo "$node" | grep -q "index"; then
            continue
        fi

        # 1. Main Stock Camera Handling (Force map video0 to avoid execution latency)
        if [ "$node" = "video0" ]; then
            logger -t uvc "Forcing explicit hotplug configuration map for stock $node."
            ln -sf /dev/$node /dev/v4l/by-id/main-video0
            echo /dev/v4l/by-id/main-video0 > /tmp/.video_stock_cam
            MDEV=main-video0 ACTION=add /usr/bin/auto_uvc.sh &

        # 2. Auxiliary Camera Verification (H264/MJPG fallback matching)
        elif [ -e "/dev/$node" ]; then
            # If it's your secondary camera node (video2), map it safely
            if [ "$node" = "video2" ]; then
                logger -t uvc "$node matched auxiliary nozzle camera configuration."
                ln -sf /dev/$node /dev/v4l/by-id/$node
                echo /dev/v4l/by-id/$node > /tmp/.video_aux_$node
                MDEV=$node ACTION=add /usr/bin/auto_uvc.sh &
            fi
        fi
    done
fi
